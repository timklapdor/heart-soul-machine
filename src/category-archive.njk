---
pagination:
  data: collections.postsByCategory
  size: 1
  alias: category
permalink: "categories/{{ category.name | slugify }}/"
layout: partials/page.njk
eleventyExcludeFromCollections: true
templateEngineOverride: njk
eleventyComputed:
  title: "{{ category.name }}"
  summary: 
---

<p>{{ category.count }}
	{% if category.count == 1 %}post{% else %}posts{% endif %} filed under {{ category.name }}.</p>

<div class="h-feed category-archive">
	<data class="p-name" value="Heart Soul Machine – {{ category.name }}"></data>

	{% for year, yearPosts in category.years %}
		<h2 class="year">{{ year }}</h2>
		<ul>
			{% for post in yearPosts %}
				<li class="h-entry">
					<time class="dt-published" datetime="{{ post.date | isoDateTime }}">{{ post.date | dayMonthDate }}</time> – <a class="u-url p-name" href="{{ post.url }}">{{ post.data.title }}</a>
					{%- if post.data.summary %}<br>
						<span class="p-summary">{{ post.data.summary }}</span>{% endif %}
				</li>
			{% endfor %}
		</ul>
	{% endfor %}
</div>

{% set categoryLinksHeading = "Other categories" %}
{% include "partials/category-links.njk" %}
